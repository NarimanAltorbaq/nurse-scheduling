@page
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="text-center py-5">
    <h1 class="display-6 mb-3">🏥 نظام جدولة دوام التمريض</h1>
    <p class="lead text-muted">تنظيم ورديات الأقسام بصلاحيات حسب الدور الوظيفي</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-primary btn-lg" asp-page="/Schedule/Index">فتح الجدول</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">تسجيل الدخول</a>
    }
</div>
