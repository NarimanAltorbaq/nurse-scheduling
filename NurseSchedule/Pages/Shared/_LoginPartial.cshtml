@using Microsoft.AspNetCore.Identity
@using NurseSchedule.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link">مرحباً، @UserManager.GetUserName(User)</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" method="post"
              asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link border-0">تسجيل الخروج</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">تسجيل الدخول</a>
    </li>
}
</ul>